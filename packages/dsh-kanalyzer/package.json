{
  "name": "@pbfuzz/dsh-kanalyzer",
  "version": "0.1.0",
  "description": "General-purpose LLVM static-analysis plugin for DeepSeek Harness: builds analysable bitcode and runs kernel-analyzer (KAMain) reachability analysis behind ctx.kanalyzer",
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "skills/**/*.md",
    "selftest/**"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs --strict",
    "prepare": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:core": "tsc -p tsconfig.core.json",
    "typecheck:client": "tsc -p src/client/tsconfig.json",
    "build:client": "node scripts/build-client.mjs",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4 <5.0.0",
    "@deepseek-ai/dsh-agent": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-commands": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-jobs": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-settings": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-skill": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  }
}
